<!-- The Play build has no captive-portal WebView, so unlike the kiosk it permits no cleartext at all. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
